{
  "_note": "Single source of truth for Line of Command V1 balance numbers. spec.md quotes these values; if they disagree, this file wins and spec.md is the bug.",
  "version": "1.4",
  "hidden_trigger_rules": {
    "_status": "v1.4 (SD-4): written down so the engine and prototype agree",
    "check_time": "each hidden trigger is checked once per tick, after that side's morale step (spec 15.3 step 4) and before the rout check; a hidden trait fires at most once per battle and is revealed on the tick it fires",
    "types": {
      "morale_below": "morale after the morale step < value",
      "tick_reached": "tick >= value",
      "distance_below": "distance after movement < value",
      "first_casualties": "strength lost this tick > 0, and >= value% of the side's starting strength S when value is set (v1.4: optional value)",
      "cannon_casualties": "strength damage dealt by enemy cannon this tick (before rounding) > 0, and >= value% of S when value is set (v1.4: optional value)"
    },
    "effect_timing": {
      "once_morale_add, restore_lost_morale_frac, rout_threshold_add": "applied at once, before the rout check that tick; rout_threshold_add lasts the rest of the battle",
      "morale_loss_from_cannon_mult": "applies to the cannon share of morale loss from the trigger tick's own morale step onwards (the trigger is tested on that tick's damage before morale is applied)",
      "duration_ticks effects (advance_add, damage_taken_mult, casualties_taken_mult)": "active for the next duration_ticks ticks after the trigger tick",
      "no_morale_loss_ticks": "unused in v1.4"
    },
    "cannon_share": "morale loss base (strengthLost + 0.25 x meleeStrengthLost) is multiplied by (1 - s x (1 - m)), where s = enemy cannon strength damage / all enemy strength damage this tick (before rounding) and m = product of morale_loss_from_cannon_mult from visible traits and any fired hidden trait"
  },
  "rules": {
    "visible_strengths": 1,
    "visible_weaknesses": 1,
    "hidden_slots": 1,
    "genetics": "Each officer carries 2 alleles per slot (strength, weakness, hidden). Offspring gets one random allele per slot from each parent. Expressed allele: dominant beats recessive. If both alleles have the same dominance and differ, one is picked by a coin flip at birth (breeding seed) and fixed for life. A recessive shows only when paired with another recessive.",
    "mutation_chance_per_allele": 0.03,
    "carrier_visibility": {
      "status": "D7 DECIDED 2026-11-22 (captain)",
      "rule": "A carried (unexpressed) allele is shown on an officer's card and in the breeding preview once ANY relative in the recorded pedigree (incl. pedigree ghosts) has expressed that trait. Otherwise it shows as 'unknown allele'."
    },
    "new_officer": "both alleles drawn uniformly from the slot's library (hidden slot: 'none' has weight 4, each hidden trait weight 1)",
    "hidden_none_note": "'none' counts as a dominant allele: it hides recessive hidden traits and coin-flips against dominant ones."
  },
