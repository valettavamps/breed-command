  "rules": {
    "visible_strengths": 1,
    "visible_weaknesses": 1,
    "hidden_slots": 1,
    "genetics": "Each officer carries 2 alleles per slot (strength, weakness, hidden). Offspring gets one random allele per slot from each parent. Expressed allele: dominant beats recessive. If both alleles have the same dominance and differ, one is picked by a coin flip at birth (breeding seed) and fixed for life. A recessive shows only when paired with another recessive.",
    "mutation_chance_per_allele": 0.03,
    "carrier_visibility": {
      "status": "D7 DECIDED 2026-11-22 (captain)",
      "rule": "A carried (unexpressed) allele is shown on an officer's card and in the breeding preview once ANY relative in the recorded pedigree (incl. pedigree ghosts) has expressed that trait. Otherwise it shows as 'unknown allele'."
    },
    "new_officer": "both alleles drawn uniformly from the slot's library (hidden slot: 'none' has weight 4, each hidden trait weight 1)",
    "hidden_none_note": "'none' counts as a dominant allele: it hides recessive hidden traits and coin-flips against dominant ones."
  },
